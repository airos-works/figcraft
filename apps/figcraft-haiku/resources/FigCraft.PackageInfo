name figcraft
version 0.18.1~airos1-2
architecture x86_64
summary "Interface designer and prototyping editor"
description "Design air/OS applications with editable kit components, the FigCraft editor and an MCP server with operator design review."
packager "air/OS"
vendor "air/OS"
copyrights { "FigCraft contributors" }
licenses { "MIT" "Apache v2" }
urls { "https://github.com/airos-works/figcraft" }
provides {
    figcraft = 0.18.1
    app:FigCraft = 0.18.1
    cmd:figcraft_cli = 0.18.1
}
requires {
    haiku >= r1~beta6
    lib:libstdc++
    lib:libgcc_s
}
post-install-scripts { "boot/post-install/figcraft.sh" }
