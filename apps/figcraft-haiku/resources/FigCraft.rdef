resource app_signature "application/x-vnd.airos-FigCraft";
resource(2, "BEOS:TYPE") #'MIMS' "application/x-vnd.Be-elfexecutable";
resource app_flags B_SINGLE_LAUNCH;
resource app_version {
    major = 0, middle = 18, minor = 1, variety = B_APPV_DEVELOPMENT, internal = 1,
    short_info = "FigCraft 0.18.1",
    long_info = "Interface design and prototyping for air/OS"
};
resource vector_icon { import "FigCraft.hvif" };
resource file_types message { "types" = "application/x-figcraft" };
